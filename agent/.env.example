# Для агента в Docker с нативной Ollama на том же компьютере.
AGENT_PORT=8000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Заменить на LAN/ZeroTier IP компьютера транспортного уровня.
TRANSPORT_BASE_URL=http://host.docker.internal:8080

# Дедлайн до манифеста: должен быть меньше GENERATION_TIMEOUT_SECONDS транспорта (120).
GENERATION_TIMEOUT_SECONDS=110
MODEL_ATTEMPTS=2
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2400
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TEMPERATURE=0.6
MAX_CONCURRENT_GENERATIONS=1
MAX_PENDING_JOBS=4
SEGMENT_DELAY_MS=150
DELIVERY_TIMEOUT_SECONDS=3
DELIVERY_ATTEMPTS=2
TERMINAL_TTL_SECONDS=900
